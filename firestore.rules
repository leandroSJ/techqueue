rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function googleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    match /days/{dayId} {
      allow read, create, update: if googleUser();

      match /attendances/{attendanceId} {
        allow read: if googleUser();

        allow create: if googleUser()
          && request.resource.data.technicianUid == request.auth.uid;

        allow update: if googleUser()
          && resource.data.technicianUid == request.auth.uid
          && request.resource.data.technicianUid
             == resource.data.technicianUid;
      }
    }
  }
}