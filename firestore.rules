rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function googleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function adminUser() {
      return googleUser()
        && request.auth.token.email == "leandro3dejesus@gmail.com";
    }

    match /profiles/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /days/{dayId} {
      allow read, create, update: if googleUser();
      allow delete: if adminUser();

      match /attendances/{attendanceId} {
        allow read: if googleUser();

        allow create: if googleUser()
          && request.resource.data.technicianUid == request.auth.uid;

        allow update: if googleUser()
          && resource.data.technicianUid == request.auth.uid
          && request.resource.data.technicianUid == resource.data.technicianUid;

        allow delete: if adminUser();
      }

      match /queuedClients/{queuedClientId} {
        allow read: if googleUser();

        allow create: if googleUser()
          && request.resource.data.fromUid == request.auth.uid;

        allow delete: if googleUser();
        allow update: if false;
      }

      match /nudges/{nudgeId} {
        allow read: if googleUser();

        allow create: if googleUser()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.targetUid is string
          && request.resource.data.targetUid != request.auth.uid;

        allow update: if false;
        allow delete: if adminUser();
      }

      match /events/{eventId} {
        allow read: if googleUser();

        allow create: if googleUser()
          && request.resource.data.fromUid == request.auth.uid;

        allow update: if false;
        allow delete: if adminUser();
      }
    }

    match /gameRooms/{roomId} {
      // A página de jogos já exige autenticação. Aqui aceitamos qualquer
      // sessão Firebase autenticada para evitar falso permission-denied
      // causado pelo provedor do token.
      allow read, create, update, delete: if signedIn();

      match /strokes/{strokeId} {
        allow read, create, delete: if signedIn();
        allow update: if false;
      }
    }
  }
}