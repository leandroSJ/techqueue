rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function googleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function adminUser() {
      return googleUser()
        && request.auth.token.email == "leandro3dejesus@gmail.com";
    }

    function activeGoogleUser() {
      return googleUser()
        && (adminUser() || !exists(/databases/$(database)/documents/bans/$(request.auth.uid)));
    }

    match /bans/{userId} {
      allow read: if googleUser()
        && (request.auth.uid == userId || adminUser());
      allow create, update, delete: if adminUser();
    }

    match /profiles/{userId} {
      allow read, create, update: if activeGoogleUser() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /days/{dayId} {
      allow read, create, update: if activeGoogleUser();
      allow delete: if adminUser();

      match /attendances/{attendanceId} {
        allow read: if activeGoogleUser();

        allow create: if activeGoogleUser()
          && request.resource.data.technicianUid == request.auth.uid;

        allow update: if activeGoogleUser()
          && resource.data.technicianUid == request.auth.uid
          && request.resource.data.technicianUid == resource.data.technicianUid;

        allow delete: if adminUser();
      }

      match /queuedClients/{queuedClientId} {
        allow read: if activeGoogleUser();

        allow create: if activeGoogleUser()
          && request.resource.data.fromUid == request.auth.uid;

        allow delete: if activeGoogleUser();
        allow update: if false;
      }

      match /nudges/{nudgeId} {
        allow read: if activeGoogleUser();

        allow create: if activeGoogleUser()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.targetUid is string
          && request.resource.data.targetUid != request.auth.uid;

        allow update: if false;
        allow delete: if adminUser();
      }

      match /events/{eventId} {
        allow read: if activeGoogleUser();

        allow create: if activeGoogleUser()
          && request.resource.data.fromUid == request.auth.uid;

        allow update: if false;
        allow delete: if adminUser();
      }
    }

    match /gameRooms/{roomId} {
      // A página de jogos já exige autenticação. Aqui aceitamos qualquer
      // sessão Firebase autenticada para evitar falso permission-denied
      // causado pelo provedor do token.
      allow read, create, update, delete: if activeGoogleUser();

      match /strokes/{strokeId} {
        allow read, create, delete: if activeGoogleUser();
        allow update: if false;
      }
    }
  }
}